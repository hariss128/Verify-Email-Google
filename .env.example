# Generate with: openssl rand -base64 32
AUTH_SECRET=your-random-secret-here

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# App URL (must match the port your dev server runs on)
AUTH_URL=http://localhost:3000

# Required for Auth.js behind localhost / proxies
AUTH_TRUST_HOST=true

# MongoDB Atlas connection string (add a database name before the ?)
# Example: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/google-verification?appName=Cluster0
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/google-verification?appName=Cluster0
